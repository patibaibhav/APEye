# ==========================================
# APEye Environment Configuration Template
# All secrets and environment-specific values go here.
# Never commit the actual .env file.
# ==========================================

# --- Core Settings (Owner: Baibhav) ---
APP_ENV=local
LOG_LEVEL=INFO
TRUSTED_PROXY_COUNT=0
ENABLE_SANDBOX=true
STATIC_DIR=app/static

# --- Detection Settings (Owner: Baibhav) ---
DETECTION_IGNORE_IPS=
DET_LOGIN_PATH=/api/auth/login
DET_BRUTE_FORCE_THRESHOLD=10
DET_BRUTE_FORCE_WINDOW_SECONDS=300
DET_RATE_THRESHOLD=100
DET_RATE_WINDOW_SECONDS=60
DET_UNAUTH_THRESHOLD=15
DET_UNAUTH_WINDOW_SECONDS=600
DET_RECON_MIN_DISTINCT=15
DET_RECON_MIN_REQUESTS=20
DET_RECON_MIN_ERROR_RATIO=0.5
DET_RECON_WINDOW_SECONDS=120
DET_RECON_SENSITIVE_PATTERNS=/admin,/.env,/.git,/config,/backup,/wp-login,/phpmyadmin,/actuator,/debug
DET_ALERT_COOLDOWN_SECONDS=600

# --- Database & Auth Settings (Owner: Anvi) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/apimonitor
DB_POOL_SIZE=5
JWT_SECRET_KEY=replace-with-a-random-secret-key-at-least-32-chars-long
JWT_EXPIRE_MINUTES=30
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password_123

# --- Storage & Reporting Settings (Owner: Anvi) ---
EXPORT_MAX_ROWS=100000
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./.local_storage
S3_BUCKET_NAME=apeye-private-reports-bucket
S3_KEY_PREFIX=dev
PRESIGNED_URL_TTL_SECONDS=300

# --- CloudWatch & AWS Settings (Owner: Anvi) ---
AWS_REGION=us-east-1
# Do NOT set AWS keys on EC2/Elastic Beanstalk in Learner Lab: the attached instance profile
# supplies temporary credentials automatically (boto3 default credential chain).
# Only for testing S3/CloudWatch from your own laptop, paste the Learner Lab 'AWS Details' values:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
CLOUDWATCH_ENABLED=false
CW_LOG_GROUP=/api-security-monitor/app
CW_LOG_STREAM_PREFIX=local-dev
CW_METRICS_NAMESPACE=ApiSecurityMonitor
CW_METRICS_FLUSH_SECONDS=60
